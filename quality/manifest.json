{
  "$schema": "./manifest.schema.json",
  "version": "1.0.0",
  "lanes": [
    {
      "id": "lane:grouping",
      "name": "Estructura Agrupada y Márgenes",
      "description": "Lógica física de módulos agrupados, continuidad de caja/golas y márgenes globales",
      "patterns": [
        "src/lib/group-engine.ts",
        "src/lib/group-result.ts",
        "src/lib/module-groups.ts",
        "db/migrations/0230_agrupacion_smg.sql",
        "db/tests/smg_agrupacion.ts"
      ],
      "tests": [
        "tests/module-groups.test.ts",
        "tests/group-engine.test.ts",
        "tests/group-result.test.ts",
        "tests/margen-global.test.ts",
        "tests/bfd-smg.test.ts",
        "tests/sbfd-smg.test.ts",
        "tests/db-smg.test.ts"
      ]
    },
    {
      "id": "lane:visualization",
      "name": "Motor de Visualización y Ensambles",
      "description": "Cálculo de posiciones 3D, IGES y despiece visual de piezas",
      "patterns": [
        "src/lib/visualizacion.ts",
        "src/lib/visualizacion-config.ts"
      ],
      "tests": [
        "tests/visualizacion.test.ts",
        "tests/visualizacion-b-fe.test.ts"
      ]
    },
    {
      "id": "lane:pricing-db",
      "name": "Servicios de Cotización y Persistencia",
      "description": "Preparación de cotizaciones, tarifas, overrides, consultas a Supabase y catálogo precompilado",
      "patterns": [
        "src/lib/cotizar.ts",
        "src/lib/catalogo-paginado.ts",
        "src/lib/cotizaciones.ts",
        "src/lib/diseno.ts",
        "src/lib/admin.ts",
        "src/lib/supabase/**",
        "src/lib/firplak-template.ts",
        "src/lib/cema-template.ts",
        "src/lib/materiales-linea.ts",
        "src/lib/precios-tableros.ts",
        "src/lib/grupos-orden.ts",
        "src/lib/materiales-proyecto.ts",
        "src/lib/propuesta-cotizacion.ts",
        "scripts/auditar-propuestas.ts",
        "src/lib/guardado-secuencial.ts",
        "src/lib/dashboard-cotizaciones.ts",
        "src/lib/dashboard-cotizaciones-datos.ts",
        "src/lib/dashboard-csv.ts",
        "src/lib/ubicacion-cotizacion.ts",
        "db/migrations/0229_dashboard_cotizaciones_ubicacion.sql"
      ],
      "tests": [
        "tests/margen-global.test.ts",
        "tests/catalogo-paginado.test.ts",
        "tests/group-result.test.ts",
        "tests/precio-herrajes.test.ts",
        "tests/consumo-materiales.test.ts",
        "tests/module-groups.test.ts",
        "tests/firplak-template.test.ts",
        "tests/materiales-linea.test.ts",
        "tests/precios-tableros-cotizacion.test.ts",
        "tests/grupos-orden.test.ts",
        "tests/propuesta-cotizacion.test.ts",
        "tests/materiales-proyecto.test.ts",
        "tests/cotizaciones.test.ts",
        "tests/guardado-secuencial.test.ts",
        "tests/dashboard-cotizaciones.test.ts",
        "tests/dashboard-csv.test.ts",
        "tests/ubicacion-cotizacion.test.ts",
        "tests/dashboard-cotizaciones-datos.test.ts"
      ]
    },
    {
      "id": "lane:engine",
      "name": "Motor Paramétrico de Despiece",
      "description": "Fórmulas de corte, cantos, herrajes, reglas de tipologías y piezas individuales",
      "patterns": [
        "src/lib/engine.ts",
        "src/lib/muebles.ts"
      ],
      "tests": [
        "tests/b12-hoja-real.test.ts",
        "tests/barras-estabilizadoras.test.ts",
        "tests/bbl.test.ts",
        "tests/bblfd-sm.test.ts",
        "tests/bov24-hoja-real.test.ts",
        "tests/carton-abierto.test.ts",
        "tests/consumo-materiales.test.ts",
        "tests/db-backing.test.ts",
        "tests/db-gavetas-mixtas.test.ts",
        "tests/db-sin-herrajes.test.ts",
        "tests/db18-hoja-real.test.ts",
        "tests/db2-1op.test.ts",
        "tests/desperdicio-tablero.test.ts",
        "tests/despiece-presentacion.test.ts",
        "tests/dimension-negativa.test.ts",
        "tests/ow3018-hoja-real.test.ts",
        "tests/pcfd-op.test.ts",
        "tests/precio-herrajes.test.ts",
        "tests/reveal-puertas.test.ts",
        "tests/sbfd-sm.test.ts",
        "tests/svfd36-hoja-real.test.ts",
        "tests/tarugos-base-tapa.test.ts",
        "tests/udv1228-2s-hoja-real.test.ts",
        "tests/versiones.test.ts",
        "tests/w-sm.test.ts",
        "tests/wld-frentes.test.ts",
        "tests/wsm.test.ts"
      ]
    },
    {
      "id": "lane:cutting",
      "name": "Optimizador de corte",
      "description": "Configuración de planta y lista de corte del optimizador (src/lib/corte).",
      "patterns": [
        "src/lib/corte/**"
      ],
      "tests": [
        "tests/optimizador-corte.test.ts",
        "tests/plan-diario-corte.test.ts",
        "tests/guillotina.test.ts",
        "tests/secuencia-corte.test.ts",
        "tests/plan-corte.test.ts",
        "tests/optimizador-reparto.test.ts",
        "tests/config.test.ts",
        "tests/optimizador-referencia.test.ts",
        "tests/secuencia.test.ts",
        "tests/reparto.test.ts"
      ]
    },
    {
      "id": "lane:frontend",
      "name": "Frontend y Vistas App Router",
      "description": "Componentes de interfaz de usuario, formularios de cotizador y páginas Next.js",
      "patterns": [
        "src/app/**",
        "src/components/**"
      ],
      "tests": [
        "tests/margen-global.test.ts",
        "tests/module-groups.test.ts",
        "tests/optimizador-corte.test.ts",
        "tests/tooltips.test.ts",
        "tests/combobox-filtro.test.ts",
        "tests/monedas-visibles.test.ts",
        "tests/iva.test.ts",
        "tests/herrajes-propuesta.test.ts",
        "tests/numero-en-letras.test.ts",
        "tests/grupos-programacion.test.ts",
        "tests/propuesta-cotizacion.test.ts",
        "tests/materiales-proyecto.test.ts",
        "tests/cotizaciones.test.ts",
        "tests/guardado-secuencial.test.ts",
        "tests/dashboard-cotizaciones.test.ts",
        "tests/dashboard-csv.test.ts",
        "tests/ubicacion-cotizacion.test.ts",
        "tests/dashboard-cotizaciones-datos.test.ts"
      ]
    },
    {
      "id": "lane:core-transversal",
      "name": "Configuraciones Core y Dependencias",
      "description": "Configuraciones globales del repositorio, tsconfig, package.json y sistema de calidad",
      "patterns": [
        ".gitignore",
        "package.json",
        "tsconfig.json",
        "eslint.config.mjs",
        "next.config.ts",
        "quality/**",
        "scripts/quality/**"
      ],
      "escalatesToFull": true,
      "tests": [
        "tests/*.test.ts"
      ]
    }
  ],
  "thresholds": {
    "testDurationWarningMs": 500,
    "testDurationCriticalMs": 1500,
    "maxNewErrorsAllowed": 0
  }
}
