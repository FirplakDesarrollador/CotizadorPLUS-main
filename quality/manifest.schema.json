{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cotizador PLUS Quality Manifest",
  "type": "object",
  "required": ["version", "lanes", "thresholds"],
  "properties": {
    "version": { "type": "string" },
    "ignoredNonProductivePatterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "patterns", "tests"],
        "properties": {
          "id": { "type": "string", "pattern": "^lane:[a-z0-9-]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "tests": {
            "type": "array",
            "items": { "type": "string" }
          },
          "escalatesToFull": { "type": "boolean" },
          "critical": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["testDurationWarningMs", "testDurationCriticalMs", "maxNewErrorsAllowed"],
      "properties": {
        "testDurationWarningMs": { "type": "number", "minimum": 1 },
        "testDurationCriticalMs": { "type": "number", "minimum": 1 },
        "stageDurationWarningMs": { "type": "number", "minimum": 1 },
        "maxNewErrorsAllowed": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
